f7-76a20482676b","name":"Call WF-33 Payment Approval Processor"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"fx70vqyJtRdF2DgR","mode":"list","cachedResultUrl":"/workflow/fx70vqyJtRdF2DgR"},"workflowInputs":{"mappingMode":"passthrough","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[800,192],"id":"320fd90b-71d5-47af-b108-23624b53f543","name":"Call WF-42 Consultation Closer"},{"parameters":{"operation":"executeQuery","query":"SELECT \n  u.id,\n  u.name,\n  u.phone_number,\n  u.status,\n  c.id as consultation_id,\n  c.started_at,\n  EXTRACT(EPOCH FROM (NOW() - c.started_at))/3600 AS hours_active\nFROM chinmay_astro.users u\nLEFT JOIN chinmay_astro.consultations c ON u.id = c.user_id AND c.status = 'active'\nWHERE u.status IN ('payment_submitted', 'consultation_active')\nORDER BY u.status DESC, c.started_at DESC;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1200,592],"id":"754478c5-b10f-4f54-992b-367c41ccc2b6","name":"Get Active Users","alwaysOutputData":true,"credentials":{"postgres":{"id":"Zomqv5wsowQAhdGl","name":"PostgreSQL - Chinmay Astro Production"}}},{"parameters":{"jsCode":"const users = $input.all().map(item => item.json);\n\nif (users.length === 0) {\n  return [{\n    json: {\n      message: \"📋 *System Status*\\n\\nNo pending payments or active consultations.\"\n    }\n  }];\n}\n\nlet message = \"📋 *System Status*\\n\\n\";\n\nconst pending = users.filter(u => u.status === 'payment_submitted');\nconst active = users.filter(u => u.status === 'consultation_active');\n\nif (pending.length > 0) {\n  message += \"*Pending Payment Verifications:*\\n\";\n  pending.forEach(u => {\n    message += `• ${u.name} (${u.phone_number})\\n`;\n  });\n  message += \"\\n\";\n}\n\nif (active.length > 0) {\n  message += \"*Active Consultations:*\\n\";\n  active.forEach(u => {\n    const hours = Math.round(u.hours_active * 10) / 10;\n    message += `• ${u.name} (${u.phone_number}) - ${hours}hrs\\n`;\n  });\n}\n\nreturn [{\n  json: {channelName:$('Switch').first().json.channelName, message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,592],"id":"123cdd74-555d-4b7a-8778-36ba5f26f735","name":"Format List"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"wlZRK0YxnhP0b2RL","mode":"list","cachedResultUrl":"/workflow/wlZRK0YxnhP0b2RL"},"workflowInputs":{"mappingMode":"defineBelow","value":{"channelId":"={{ $('When Executed by Another Workflow').item.json.channelId }}","messageText":"={{ $json.message }}"},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1616,592],"id":"a5eb53b4-e90d-4e47-8491-d155b26be480","name":"Send List To Admin","webhookId":"830299cd-6863-4dd0-9bda-2ee185f2260c","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"operation":"executeQuery","query":"SELECT \n  (SELECT COUNT(*) FROM chinmay_astro.users) as total_users,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'consultation_active') as active_consultations,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'payment_submitted') as pending_payments,\n  (SELECT COUNT(*) FROM chinmay_astro.consultations WHERE status = 'closed' AND DATE(ended_at) = CURRENT_DATE) as completed_today,\n  (SELECT COALESCE(SUM(amount), 0) FROM chinmay_astro.payments WHERE status = 'verified' AND DATE(verified_at) = CURRENT_DATE) as revenue_today,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'blocked') as blocked_users;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1200,800],"id":"0ffb8350-eae8-4f5c-8488-a16cf4112faf","name":"Get Stats","alwaysOutputData":true,"credentials":{"postgres":{"id":"Zomqv5wsowQAhdGl","name":"PostgreSQL - Chinmay Astro Production"}}},{"parameters":{"jsCode":"const stats = $input.first().json;\n\nconst message = `📈 *Today's Statistics*\n\n*Users:*\n- Total Users: ${stats.total_users}\n- Active Consultations: ${stats.active_consultations}\n- Pending Payments: ${stats.pending_payments}\n- Blocked: ${stats.blocked_users}\n\n*Today's Activity:*\n- Completed: ${stats.completed_today}\n- Revenue: ₹${stats.revenue_today}`;\n\nreturn [{\n  json: {channelName: $('Switch').first().json.channelName,\n    message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,800],"id":"3c5abb8e-846b-44c6-8447-16139d1be870","name":"Format Stats"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"wlZRK0YxnhP0b2RL","mode":"list","cachedResultUrl":"/workflow/wlZRK0YxnhP0b2RL"},"workflowInputs":{"mappingMode":"defineBelow","value":{"channelId":"={{ $('When Executed by Another Workflow').item.json.channelId }}","messageText":"={{ $json.message }}"},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1616,800],"id":"9f024558-adff-4b9e-8de3-6f74b280b75a","name":"Send Stats To Admin","webhookId":"d50482aa-5f75-4052-b45a-96edee651bb8","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"jsCode":"const helpText = `📖 *Available Commands*\n\n*Payment Management:*\n\\`APPROVE PAYMENT <phone>\\` - Approve payment and activate consultation\n\\`REJECT PAYMENT <phone>\\` - Reject payment (user can resubmit)\n\n*Consultation Management:*\n\\`CLOSE CONSULTATION <phone>\\` - End consultation and send feedback form\n\\`BLOCK <phone> [reason]\\` - Block user permanently\n\n*Information:*\n\\`LIST\\` - Show pending payments and active consultations\n\\`STATS\\` - Show today's statistics\n\\`HELP\\` - Show this help message\n\n*Examples:*\n\\`APPROVE PAYMENT 61466927921\\`\n\\`CLOSE CONSULTATION 61466927921\\`\n\\`BLOCK 61466927921 spam behavior\\``;\n\nreturn [{\n  json: {channelName: $input.first().json.channelName,\n    message: helpText\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1216,992],"id":"95ecde72-6228-4bc2-b175-c2f22f3cbe63","name":"Prepare HELP Text"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"wlZRK0YxnhP0b2RL","mode":"list","cachedResultUrl":"/workflow/wlZRK0YxnhP0b2RL"},"workflowInputs":{"mappingMode":"defineBelow","value":{"channelId":"={{ $json.channelId }}","messageText":"=❓ Unknown command: `{{ $json.messageText }}`  Type `HELP` to see available commands."},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[-240,1424],"id":"71a6d08c-623d-4482-b1d3-72a53f5199ab","name":"Unknown Command Response","webhookId":"2fde5e82-bd1c-4fe2-bc21-84e565f39e96","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"se82n3MUQ9xE5aEr","mode":"list","cachedResultUrl":"/workflow/se82n3MUQ9xE5aEr"},"workflowInputs":{"mappingMode":"passthrough","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[400,96],"id":"132100fc-2e8a-4c0b-885b-27b3ec86a8f6","name":"Call WF-34 Payment Rejection Processor"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"UV62An60fzflU0uD","mode":"list","cachedResultUrl":"/workflow/UV62An60fzflU0uD"},"workflowInputs":{"mappingMode":"passthrough","value":{}