mit)\n\n*Consultation Management:*\n\\`CLOSE CONSULTATION <phone>\\` - End consultation and send feedback form\n\\`BLOCK <phone> [reason]\\` - Block user permanently\n\n*Information:*\n\\`LIST\\` - Show pending payments and active consultations\n\\`STATS\\` - Show today's statistics\n\\`HELP\\` - Show this help message\n\n*Examples:*\n\\`APPROVE PAYMENT 61466927921\\`\n\\`CLOSE CONSULTATION 61466927921\\`\n\\`BLOCK 61466927921 spam behavior\\``;\n\nreturn [{\n  json: {channelName: $input.first().json.channelName,\n    message: helpText\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1216,992],"id":"95ecde72-6228-4bc2-b175-c2f22f3cbe63","name":"Prepare HELP Text"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"wlZRK0YxnhP0b2RL","mode":"list","cachedResultUrl":"/workflow/wlZRK0YxnhP0b2RL"},"workflowInputs":{"mappingMode":"defineBelow","value":{"channelId":"={{ $json.channelId }}","messageText":"=❓ Unknown command: `{{ $json.messageText }}`  Type `HELP` to see available commands."},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[-240,1424],"id":"71a6d08c-623d-4482-b1d3-72a53f5199ab","name":"Unknown Command Response","webhookId":"2fde5e82-bd1c-4fe2-bc21-84e565f39e96","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"se82n3MUQ9xE5aEr","mode":"list","cachedResultUrl":"/workflow/se82n3MUQ9xE5aEr"},"workflowInputs":{"mappingMode":"passthrough","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[400,96],"id":"132100fc-2e8a-4c0b-885b-27b3ec86a8f6","name":"Call WF-34 Payment Rejection Pro