h > 0) {\n  message += \"*Pending Payment Verifications:*\\n\";\n  pending.forEach(u => {\n    message += `• ${u.name} (${u.phone_number})\\n`;\n  });\n  message += \"\\n\";\n}\n\nif (active.length > 0) {\n  message += \"*Active Consultations:*\\n\";\n  active.forEach(u => {\n    const hours = Math.round(u.hours_active * 10) / 10;\n    message += `• ${u.name} (${u.phone_number}) - ${hours}hrs\\n`;\n  });\n}\n\nreturn [{\n  json: {channelName:$('Switch').first().json.channelName, message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,592],"id":"123cdd74-555d-4b7a-8778-36ba5f26f735","name":"Format List"},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"wlZRK0YxnhP0b2RL","mode":"list","cachedResultUrl":"/workflow/wlZRK0YxnhP0b2RL"},"workflowInputs":{"mappingMode":"defineBelow","value":{"channelId":"={{ $('When Executed by Another Workflow').item.json.channelId }}","messageText":"={{ $json.message }}"},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1616,592],"id":"a5eb53b4-e90d-4e47-8491-d155b26be480","name":"Send List To Admin","webhookId":"830299cd-6863-4dd0-9bda-2ee185f2260c","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"operation":"executeQuery","query":"SELECT \n  (SELECT COUNT(*) FROM chinmay_astro.users) as total_users,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'consultation_active') as active_consultations,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'payment_submitted') as pending_payments,\n  (SELECT COUNT(*) FROM chinmay_astro.consultations WHERE status = 'closed' AND DATE(ended_at) = CURRENT_DATE) as completed_today,\n  (SELECT COALESCE(SUM(amount), 0) FROM chinmay_astro.payments WHERE status = 'verified' AND DATE(verified_at) = CURRENT_DATE) as 