    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst intent = d.intentResult;\n\nlet contextualIntro = 'To proceed with your consultation, please fill in your birth details using the form below.';\nif (intent === 'wants_consultation') contextualIntro = 'Great! Please fill in your birth details to book your Vedic astrology consultation with Chinmay.';\nelse if (intent === 'general_enquiry') contextualIntro = 'Thanks for your question! To get started with your personalised consultation, please fill in your birth details below.';\n\nconst messageText = [\n  contextualIntro,\n  '',\n  '📋 Privacy Policy: https://chinmaymujumdar.com/privacy-policy'\n].join('\\n');\n\nreturn [{ json: {\n  phoneNumber: d.phoneNumber,\n  messageType: 'interactive',\n  interactivePayload: {\n    type: 'flow',\n    header: { type: 'text', text: 'Birth Details Form' },\n    body: { text: messageText },\n    flowId: '1408011897720771',\n    flowCta: 'Fill Details'\n  }\n} }];"
      },
