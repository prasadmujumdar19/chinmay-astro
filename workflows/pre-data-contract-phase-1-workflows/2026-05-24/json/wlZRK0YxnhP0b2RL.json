      "id": "node-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        460,
        340
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $json.channelId }}",
          "mode": "id"
        },
        "text": "={{ $json.messageText }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "WSds5JWe5b6N7myY",
          "name": "Slack - Chinmay Astro"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build canonical WF-60 input payload for Slack-outbound logging.\n// Chained after Post to Slack — uses the Slack API response ts for slack_message_ts.\n// WF-51 caller may optionally pass userId/consultationId; WF-60 falls back to slack_channel_id lookup.\nconst triggerInput = $('Execute Workflow Trigger').first().json;\nconst slackResp = $input.first().json;\n\nconst channelId = triggerInput.channelId || slackResp.channel || null;\nconst slackMessageTs = slackResp.ts || (slackResp.message && slackResp.message.ts) || null;\nconst messageText = triggerInput.messageText || (slackResp.message && slackResp.message.text) || null;\n\nreturn [{\n  json: {\n    transport: 'slack',\n    direction: 'outbound',\n    messageType: 'slack_text',\n    content: messageText,\n    slackChannelId: channelId,\n    slackMessageTs: slackMessageTs,\n    userId: triggerInput.userId || null,\n    consultationId: triggerInput.consultationId || null,\n    whatsappMessageId: null,\n    phoneNumber: null,\n    metadata: {\n      transport: 'slack',\n      slackChannelId: channelId,\n      slackMessageTs: slackMessageTs,\n      slackApiOk: slackResp.ok != null ? slackResp.ok : null,\n      timestamp: new Date().toISOString()\n    }\n  }\n}];\n"
      },
      "id": "f128364f-73ea-4921-9ae2-978f8a661906",
      "name": "Build WF-60 Payload (Slack Outbound)",
      "type": "n8n-nodes-base.code",
