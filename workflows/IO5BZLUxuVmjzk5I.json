      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst userName = input.userName || 'user';\nconst phoneNumber = input.phoneNumber || '';\n\n// Clean username - remove spaces, special chars, lowercase\nconst cleanName = userName\n  .toLowerCase()\n  .replace(/[^a-z0-9]/g, '-')\n  .replace(/-+/g, '-')\n  .substring(0, 20); // Max 20 chars\n\n// Channel name format: consult-username-phonenumber\nconst channelName = `consult-${cleanName}-${phoneNumber}`;\n\nreturn [{\n  json: {\n    channelName: channelName,\n    userName: userName,\n    phoneNumber: phoneNumber,\n    userId: input.userId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
