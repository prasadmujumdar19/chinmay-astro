      "parameters": {
        "jsCode": "// Handle Meta Webhook Verification\nconst query = $input.item.json.query;\n\nif (query && query['hub.mode'] === 'subscribe' && query['hub.verify_token']) {\n  return { challenge: query['hub.challenge'], verified: true };\n}\n\nreturn { error: 'Invalid verification', verified: false };"
      },
