    {
      "parameters": {
        "jsCode": "// Parse incoming WhatsApp webhook payload\nconst body = $input.item.json.body;\n\nif (!body || !body.entry || !body.entry[0]) {\n  return { skip: true, reason: 'No entry in payload' };\n}\n\nconst entry = body.entry[0];\nconst changes = entry.changes;\n\nif (!changes || !changes[0]) {\n  return { skip: true, reason: 'No changes in entry' };\n}\n\nconst value = changes[0].value;\n\nif (!value.messages || !value.messages[0]) {\n  return { skip: true, reason: 'Not a message event' };\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts ? value.contacts[0] : null;\n\nlet messageContent = '';\nlet messageType = message.type;\n\nswitch (messageType) {\n  case 'text':\n    messageContent = message.text.body;\n    break;\n  case 'interactive':\n    if (message.interactive.button_reply) {\n      messageContent = message.interactive.button_reply.id;\n    } else if (message.interactive.list_reply) {\n      messageContent = message.interactive.list_reply.id;\n    }\n    break;\n  default:\n    messageContent = `[${messageType.toUpperCase()}]`;\n}\n\nreturn {\n  skip: false,\n  messageId: message.id,\n  timestamp: message.timestamp,\n  phoneNumber: message.from,\n  phoneNumberFormatted: '+' + message.from,\n  contactName: contact ? contact.profile.name : null,\n  messageType: messageType,\n  messageContent: messageContent,\n  messageContentUpper: messageContent.toUpperCase().trim(),\n  rawMessage: message,\n  metadata: {\n    phoneNumberId: value.metadata.phone_number_id,\n    displayPhoneNumber: value.metadata.display_phone_number\n  }\n};"
      },
