    {
      "parameters": {
        "jsCode": "// Handle Meta webhook verification (GET request)\nconst webhookData = $input.item.json;\nconst query = webhookData.query || {};\n\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\nconst VERIFY_TOKEN = 'chinya_astro_2026';\n\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  return {\n    statusCode: 200,\n    body: challenge\n  };\n} else if (mode && token) {\n  return {\n    statusCode: 403,\n    body: 'Forbidden'\n  };\n}\n\n// For POST requests (actual messages), pass through\nreturn webhookData;"
      },
