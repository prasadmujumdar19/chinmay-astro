pleted_today,\n  (SELECT COALESCE(SUM(amount), 0) FROM chinmay_astro.payments WHERE status = 'approved' AND DATE(verified_at) = CURRENT_DATE) as revenue_today,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'blocked') as blocked_users;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1200,800],"id":"0ffb8350-eae8-4f5c-8488-a16cf4112faf","name":"Get Stats","alwaysOutputData":true,"credentials":{"postgres":{"id":"Zomqv5wsowQAhdGl","name":"PostgreSQL - Chinmay Astro Production"}}},{"parameters":{"jsCode":"const stats = $input.first().json;\n\nconst message = `📈 *Today's Statistics*\n\n*Users:*\n- Total Users: ${stats.total_users}\n- Active Consultations: ${stats.active_consultations}\n- Pending Payments: ${stats.pending_payments}\n- Blocked: ${stats.blocked_users}\n\n*Today's Activity:*\n- Completed: ${stats.completed_today}\n- Revenue: ₹${stats.revenue_today}`;\n\nreturn [{\n  json: {\n    message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,800],"id":"3c5abb8e-846b-44c6-8447-16139d1be870","name":"Format Stats"},{"parameters":{"select":"channel","channelId":{"__rl":true,"value":"C0A5B0ZE81E","mode":"list","cachedResultName":"chinmay-admin-commands"},"text":"={{ $json.message }}","otherOptions":{}},"type":"n8n-nodes-base.slack","typeVersion":2.3,"position":[1616,800],"id":"9f024558-adff-4b9e-8de3-6f74b280b75a","name":"Send Stats To Admin","webhookId":"d50482aa-5f75-4052-b45a-96edee651bb8","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"jsCode":"const helpText = `📖 *Available Commands*\n\n*Payment Management:*\n\\`APPROVE PAYMENT <phone>\\` - Approve payment and activate consultation\n\\`REJECT PAYMENT <phone>\\` - Reject payment (user can resubmit)\n\n*Consultation Management:*\n\\`CLOSE CONSULTATION <phone>\\` - End consultation and send feedback form\n\\`BLOCK <phone> [reason]\\` - Block user permanently\n\n*Information:*\n\\`LIST\\` - 