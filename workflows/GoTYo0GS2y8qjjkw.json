|| subCommand === 'CONSULT')) {\n  commandType = 'CLOSE_CONSULTATION';\n\n  } else if (command === 'UNBLOCK') {\n    commandType = 'UNBLOCK_USER';\n    targetPhone = parts.slice(1).join(' ').trim();\n  } else if (command === 'BLOCK') {\n  phoneNumber = subCommand.replace(/^\\+/, '');\n  commandType = 'BLOCK_USER';\n} else if (command === 'LIST') {\n  commandType = 'LIST';\n} else if (command === 'STATS') {\n  commandType = 'STATS';\n} else if (command === 'HELP') {\n  commandType = 'HELP';\n}\n\nreturn [{\n  json: {\n    commandType: commandType,\n    targetPhone: targetPhone,\n    command: command,\n    subCommand: subCommand,\n    phoneNumber: phoneNumber,\n    reason: arg2,\n    originalMessage: messageText,\n    adminUserId: adminUserId,\n    channelId: channelId,\n    channelName: channelName\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-640,864],"id":"0b6ad029-1065-43c8-9437-840d706efc1d","name":"Parse Command"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.commandType }}","rightValue":"APPROVE_PAYMENT","operator":{"type":"string","operation":"equals"},"id":"ee255744-d09c-4d59-9464-8cf608e070f8"}],"combinator":"and"},"renameOutput":true,"outputKey":"APPROVE_PAYMENT"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"ed80be58-4490-46bb-b68e-67fe98e990af","leftValue":"={{ $json.commandType }}","rightValue":"REJECT_PAYMENT","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"REJECT_PAYMENT"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"67ae3d1d-7ad7-4d9f-b4c1-c8949f6fa2e4","leftValue":"={{ $json.commandType }}","rightValue":"CLOSE_CONSULTATION","operator":{"type":"string","operation":"