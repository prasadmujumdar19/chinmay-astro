 u.phone_number,\n  u.status,\n  c.id as consultation_id,\n  c.started_at,\n  EXTRACT(EPOCH FROM (NOW() - c.started_at))/3600 AS hours_active\nFROM chinmay_astro.users u\nLEFT JOIN chinmay_astro.consultations c ON u.id = c.user_id AND c.status = 'active'\nWHERE u.status IN ('payment_submitted', 'consultation_active')\nORDER BY u.status DESC, c.started_at DESC;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1200,592],"id":"754478c5-b10f-4f54-992b-367c41ccc2b6","name":"Get Active Users","alwaysOutputData":true,"credentials":{"postgres":{"id":"Zomqv5wsowQAhdGl","name":"PostgreSQL - Chinmay Astro Production"}}},{"parameters":{"jsCode":"const users = $input.all().map(item => item.json);\n\nif (users.length === 0) {\n  return [{\n    json: {\n      message: \"📋 *System Status*\\n\\nNo pending payments or active consultations.\"\n    }\n  }];\n}\n\nlet message = \"📋 *System Status*\\n\\n\";\n\nconst pending = users.filter(u => u.status === 'payment_submitted');\nconst active = users.filter(u => u.status === 'consultation_active');\n\nif (pending.length > 0) {\n  message += \"*Pending Payment Verifications:*\\n\";\n  pending.forEach(u => {\n    message += `• ${u.name} (${u.phone_number})\\n`;\n  });\n  message += \"\\n\";\n}\n\nif (active.length > 0) {\n  message += \"*Active Consultations:*\\n\";\n  active.forEach(u => {\n    const hours = Math.round(u.hours_active * 10) / 10;\n    message += `• ${u.name} (${u.phone_number}) - ${hours}hrs\\n`;\n  });\n}\n\nreturn [{\n  json: {\n    message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,592],"id":"123cdd74-555d-4b7a-8778-36ba5f26f735","name":"Format List"},{"parameters":{"select":"channel","channelId":{"__rl":true,"value":"C0A5B0ZE81E","mode":"list","cachedResultName":"chinmay-admin-commands"},"text":"={{ $json.message }}","otherOptions":{}},"type":"n8n-nodes-base.slack","typeVersion":2.3,"position":[1616,592],"id":"a5eb53b4-e90d-4e47-8491-d155b26be480","name":"Send List To Admin","webhookId":"830299cd-6863-4dd0-9bda-2ee185f2260c","credentials":{"slackApi":{"id":"WSds5JWe5b6N7myY","name":"Slack - Chinmay Astro"}}},{"parameters":{"operation":"executeQuery","query":"SELECT \n  (SELECT COUNT(*) FROM chinmay_astro.users) as total_users,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'consultation_active') as active_consultations,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'payment_submitted') as pending_payments,\n  (SELECT COUNT(*) FROM chinmay_astro.consultations WHERE status = 'closed' AND DATE(ended_at) = CURRENT_DATE) as completed_today,\n  (SELECT COALESCE(SUM(amount), 0) FROM chinmay_astro.payments WHERE status = 'approved' AND DATE(verified_at) = CURRENT_DATE) as revenue_today,\n  (SELECT COUNT(*) FROM chinmay_astro.users WHERE status = 'blocked') as blocked_users;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1200,800],"id":"0ffb8350-eae8-4f5c-8488-a16cf4112faf","name":"Get Stats","alwaysOutputData":true,"credentials":{"postgres":{"id":"Zomqv5wsowQAhdGl","name":"PostgreSQL - Chinmay Astro Production"}}},{"parameters":{"jsCode":"const stats = $input.first().json;\n\nconst message = `📈 *Today's Statistics*\n\n*Users:*\n- Total Users: ${stats.total_users}\n- Active Consultations: ${stats.active_consultations}\n- Pending Payments: ${stats.pending_payments}\n- Blocked: ${stats.blocked_users}\n\n*Today's Activity:*\n- Completed: ${stats.completed_today}\n- Revenue: ₹${stats.revenue_today}`;\n\nreturn [{\n  json: {\n    message: message\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,800],"id":"3c5abb8e-846b-44c6-8447-16139d1be870","name":"Format Stats"},{"parameters":{"select":"channel","channelId":{"__rl":true,"value":"C0A5B0ZE81E","mode":"list","cachedResultName":"chinmay-admin-commands"},"text":"={{ $json.message }}","otherOptions":{}},"type":"n8n-nodes-base.slack","typeVersion":2.3,"position":[1616,800],"id":"9f024558-adff-4b9e-8