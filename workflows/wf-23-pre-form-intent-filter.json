    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst intent = d.intentResult;\nlet contextual = \"Happy to help! To proceed with your consultation with Chinmay, please fill in your details using the form below.\";\nif (intent === 'wants_consultation') contextual = \"Great! To book your Vedic astrology consultation with Chinmay, please fill in your birth details using the form below.\";\nelse if (intent === 'general_enquiry') contextual = \"Thanks for your question! To get started with your personalised consultation, please fill in your details using the form below.\";\nreturn [{ json: { phoneNumber: d.phoneNumber, messageType: 'text', message: contextual } }];"
