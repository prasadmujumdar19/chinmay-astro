        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst phoneNumber = input.phoneNumber;\nconst userId = input.id || null;\nconst messageId = input.messageId || null;\nconst userMessage = input.messageContent || null;\n\nconst policyUrl = 'https://chinmaymujumdar.com/privacy-policy';\n\nconst messageText = [\n  'Welcome! 🙏',\n  '',\n  \"I'm Chinmay Mujumdar, a Vedic astrology consultant.\",\n  '',\n  '📋 Privacy Policy: ' + policyUrl,\n  '',\n  '✨ How it works:',\n  '• Share your birth details using the form below',\n  '• Pay ₹500 consultation fee via GPay',\n  '• Receive your personalised Vedic astrology consultation on WhatsApp',\n  '',\n  'To get started, please fill in the form with your birth details.'\n].join('\\n');\n\nconst interactivePayload = {\n  type: 'flow',\n  header: { type: 'text', text: 'Birth Details Form' },\n  body: { text: messageText },\n  flowId: '1408011897720771',\n  flowCta: 'Fill Details'\n};\n\nreturn [{\n  json: {\n    phoneNumber,\n    phoneNumberFormatted: input.phoneNumberFormatted || phoneNumber,\n    messageType: 'interactive',\n    messageContent: messageText,\n    interactivePayload,\n    userId,\n    inboundMessageId: messageId,\n    userMessage\n  }\n}];"
