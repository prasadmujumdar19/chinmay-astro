    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chinmay_astro.pending_users (phone_number, contact_name, created_at)\nVALUES ($1, $2, NOW())\nON CONFLICT (phone_number) DO UPDATE \n  SET contact_name = EXCLUDED.contact_name,\n      created_at = NOW()\nRETURNING phone_number",
