rim();\nconst messageUpper = messageText.toUpperCase();\n\n// DR-13 keyword categorisation\n// Admin-wide commands (no phone argument) — allowed in chinmay-admin-commands\nconst adminWideKeywords = ['LIST', 'STATS', 'HELP'];\n// User-targeted commands (carry a phone argument) — must be typed in consult-{phone} channel\nconst userTargetedKeywords = ['APPROVE', 'REJECT', 'CLOSE', 'BLOCK', 'UNBLOCK'];\n\nconst isAdminCommand = adminWideKeywords.some(kw => messageUpper.startsWith(kw));\nconst matchedUserTargeted = userTargetedKeywords.find(kw => messageUpper.startsWith(kw));\nconst wrongChannel = !isAdminCommand && !!matchedUserTargeted;\n\nreturn [{\n  json: {\n    messageText: messageText,\n    adminUserId: input.user_id,\n    channelId: input.channel_id,\n    channelName: input.name_normalized,\n    isAdminCommand: isAdminCommand,\n    wrongChannel: wrongChannel,\n    commandHint: matchedUserTargeted || null,\n    // Backward-compat: switch rule[2] checks isCommand=false. We treat admin-wide as the only valid command in this channel.\n    isCommand: isAdminCommand\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[688,64],"id":"ee68f3e7-8ecf-4316-ac12-d65ccc210e78","name":"Detect Command - Admin Channel"},{"parameters":{"jsCode":"const input = $input.first().json;\n// Strip Slack mrkdwn formatting (backticks, bold, italic) from start/end\nconst messageText = (input.message_text || '').trim().replace(/^[`*_~]+|[`*_~]+$/g, '').trim();\n\n// Command keywords\nconst commandKeywords = ['APPROVE', 'REJECT', 'CLOSE', 'BLOCK', 'UNBLOCK', 'LIST', 'STATS', 'HELP'];\n\n// Check if message starts with a command (case insensitive)\nconst messageUpper = messageText.toUpperCase();\nconst isCommand = commandKeywords.some(keyword => messageUpper.startsWith(keyword));\n\nreturn [{\n  json: {\n    messageText: messageText,\n    adminUserId: input.user_id,\n    channelId: input.channel_id,\n    channelName: input.name_normalized,\n    isCommand: isCommand\n  }\n}];"},"