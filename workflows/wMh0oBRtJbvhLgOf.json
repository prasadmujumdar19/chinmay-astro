/ DR-13 keyword categorisation\n// Admin-wide commands (no phone argument) — allowed in chinmay-admin-commands\nconst adminWideKeywords = ['LIST', 'STATS', 'HELP'];\n// User-targeted commands (carry a phone argument) — must be typed in consult-{phone} channel\nconst userTargetedKeywords = ['APPROVE', 'REJECT', 'CLOSE', 'BLOCK', 'UNBLOCK'];\n\nconst isAdminCommand = adminWideKeywords.some(kw => messageUpper.startsWith(kw));\nconst matchedUserTargeted = userTargetedKeywords.find(kw => messageUpper.startsWith(kw));\nconst wrongChannel = !isAdminCommand && !!matchedUserTargeted;\n\nreturn [{\n  json: {\n    messageText: messageText,\n    adminUserId: input.user_id,\n    channelId: input.channel_id,\n    channelName: input.name_normalized,\n    isAdminCommand: isAdminCommand,\n    wrongChannel: wrongChannel,\n    commandHint: matchedUserTargeted || null,\n    // Backward-compat: switch rule[2] checks isCommand=false. We treat admin-wide as the only valid command in this channel.\n    isCommand: isAdminCommand\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[688,64],"id":"ee68f3e7-8ecf-4316-ac12-d65ccc210e78","name":"Detect Command - Admin Channel"},{"parameters":{"jsCode":"const input = $input.first().json;\n// Strip Slack mrkdwn formatting (backticks, bold, italic) from start/end\nconst messageText = (input.message_text || '').trim().replace(/^[`*_~]+|[`*_~]+$/g, '').trim();\n\n// Command keywords\nconst commandKeywords = ['APPROVE', 'REJECT', 'CLOSE', 'BLOCK', 'UNBLOCK', 'LIST', 'STATS', 'HELP'];\n\n// Check if message starts with a command (case insensitive)\nconst messageUpper = messageText.toUpperCase();\nconst isCommand = commandKeywords.some(keyword => messageUpper.startsWith(keyword));\n\nreturn [{\n  json: {\n    messageText: messageText,\n    adminUserId: input.user_id,\n    channelId: input.channel_id,\n    channelName: input.name_normalized,\n    isCommand: isCommand\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[688,256],"id":"8be8d0fe-15ee-418a-bde8-a9f4a4670797","name":"Detect Command - User Channel"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.isAdminCommand }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true},"id":"wf10-rule-admin-cmd"}],"combinator":"and"},"renameOutput":true,"outputKey":"Admin Command"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.wrongChannel }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true},"id":"wf10-rule-wrong-channel"}],"combinator":"and"},"renameOutput":true,"outputKey":"Wrong Channel"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.isCommand }}","rightValue":"","operator":{"type":"boolean","operation":"false","singleValue":true},"id":"wf10-rule-not-command"}],"combinator":"and"},"renameOutput":true,"outputKey":"Not Command"}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.3,"position":[896,64],"id":"62f8c1e7-ef27-4494-aaa3-5f0a7107c343","name":"Command - Admin Channel ?"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.isCommand }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true},"id":"7e1e1517-5ca4-4712-a49c-cff2f3711b5f"}],"combinator":"and"},"renameOutput":true,"outputKey":"Command"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"e3252436-f75c-4af2-8890-5d5860858514","leftValue":"={{ $json.isCommand }}","rightValue":"","operator":{"type":"boolean","operation":"false","singleValue":true}}],"combinator":"and"},"renameOut