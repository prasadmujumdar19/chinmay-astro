{"updatedAt":"2026-05-17T11:56:16.022Z","createdAt":"2025-12-26T04:55:01.837Z","id":"JQu1MkK5vgtUCeNO","name":"WF-00 Webhook Receiver","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"whatsapp-astro-webhook","responseMode":"responseNode","options":{}},"id":"c553a3bf-69e6-4127-82d4-b14677ffc631","name":"WhatsApp Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1120,96],"webhookId":"whatsapp-webhook-dealfinder","onError":"continueRegularOutput"},{"parameters":{"jsCode":"// Parse incoming WhatsApp webhook payload\nconst body = $input.item.json.body;\n\nif (!body || !body.entry || !body.entry[0]) {\n  return { skip: true, reason: 'No entry in payload' };\n}\n\nconst entry = body.entry[0];\nconst changes = entry.changes;\n\nif (!changes || !changes[0]) {\n  return { skip: true, reason: 'No changes in entry' };\n}\n\nconst value = changes[0].value;\n\nif (!value.messages || !value.messages[0]) {\n  return { skip: true, reason: 'Not a message event' };\n}\n\nconst message = value.messages[0];\n\n// Bot echo filter: skip if outbound message is echoed back by Meta\nconst botPhone = value.metadata.display_phone_number.replace(/\\D/g, '');\nif (message.from === botPhone) {\n  return { skip: true, reason: 'Bot echo — outbound message reflected back' };\n}\n\nconst contact = value.contacts ? value.contacts[0] : null;\n\nlet messageContent = '';\nlet messageType = message.type;\n\nswitch (messageType) {\n  case 'text':\n    messageContent = message.text.body;\n    break;\n  case 'interactive':\n    if (message.interactive.button_reply) {\n      messageContent = message.interactive.button_reply.id;\n    } else if (message.interactive.list_reply) {\n      messageContent = message.interactive.list_reply.id;\n    }\n    break;\n  default:\n    messageContent = `[${messageType.toUpperCase()}]`;\n}\n\n// Guard: skip whitespace-only text messages — blank input would confuse intent classifier\nif (messageType === 'text' && (!messageContent || messageContent.trim().length === 0)) {\n  return { skip: true, reason: 'Whitespace-only text message — skipped' };\n}\n\nreturn {\n  skip: false,\n  messageId: message.id,\n  timestamp: message.timestamp,\n  phoneNumber: message.from,\n  phoneNumberFormatted: '+' + message.from,\n  contactName: contact ? contact.profile.name : null,\n  messageType: messageType,\n  messageContent: messageContent,\n  messageContentUpper: messageContent.toUpperCase().trim(),\n  rawMessage: message,\n  metadata: {\n    phoneNumberId: value.metadata.phone_number_id,\n    displayPhoneNumber: value.metadata.display_phone_number\n  }\n};"},"id":"57e0b4bb-fa9e-48cd-a326-87cbcbd94510","name":"Parse WhatsApp Message","type":"n8n-nodes-base.code","typeVersion":2,"position":[-896,96]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"skip-check","leftValue":"={{ $('Parse WhatsApp Message').item.json.skip }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"637a2201-0ee7-454f-9812-b01ed844d4e4","name":"Should Skip?","type":"n8n-nodes-base.if","typeVersion":2,"position":[-672,96]},{"parameters":{"respondWith":"json","responseBody":"={\"status\":\"skipped\"}","options":{"responseCode":200}},"id":"0e269193-8b6e-4e09-a12e-41fe2ac77e74","name":"Return 200 (Skip)","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[0,0]},{"parameters":{"operation":"call_workflow","source":"database","workflowId":{"__rl":true,"value":"hYGNM97sXvdo1WmI","mode":"list","cachedResultUrl":"/workflow/hYGNM97sXvdo1WmI","cachedResultName":"WF-01 Message Router"},"workflowInputs":{"mappingMode":"passthrough","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"mode":"once","options":{}},"id":"cf6967e0-9503-44f8-8fa0-8e873d64c525","name":"Call WF-01 Message Router","type":"n8n-nodes-b