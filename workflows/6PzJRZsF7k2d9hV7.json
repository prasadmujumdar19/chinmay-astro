        "operation": "executeQuery",
        "query": "SELECT * FROM users \nWHERE phone_number = $1\n  AND status = 'consultation_active'\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.phoneNumber }}"
        }
      },
