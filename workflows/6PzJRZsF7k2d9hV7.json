      "name": "Post to Slack Channel",
      "webhookId": "859062ec-a545-41d9-a78f-e1b74af52a7e",
      "credentials": {
        "slackApi": {
          "id": "WSds5JWe5b6N7myY",
          "name": "Slack - Chinmay Astro"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst channelName = input.channelName; // e.g., \"consult-prasad-61466927921\"\n\n// Extract phone number from channel name (everything after last dash + username)\nconst parts = channelName.split('-');\nconst phoneNumber = parts[parts.length - 1]; // \"61466927921\"\n\nreturn [{\n  json: {\n    ...input,\n    phoneNumber: phoneNumber,\n    adminMessage: input.messageText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        192
      ],
      "id": "dac77fd7-cd25-4a75-9935-32171f9c64c9",
      "name": "Extract Phone from Channel"
    },
    {
