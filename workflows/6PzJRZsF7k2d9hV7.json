      "name": "Route by Direction"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst userName = input.user?.name || 'user';\nconst phoneNumber = input.phoneNumber;\n\n// Clean username - same logic as WF-52\nconst cleanName = userName\n  .toLowerCase()\n  .replace(/[^a-z0-9]/g, '-')\n  .replace(/-+/g, '-')\n  .substring(0, 20);\n\n// Channel name format: consult-username-phonenumber\nconst channelName = `consult-${cleanName}-${phoneNumber}`;\n\nreturn [{\n  json: {\n    ...input,\n    channelName: channelName,\n    messageText: input.messageContent\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "7cebd1ae-05ef-43f6-9e44-cdc4da4b2da3",
      "name": "Prepare Channel Lookup"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "=#{{ $('Prepare Channel Lookup').item.json.channelName }}",
          "mode": "name"
        },
        "text": "=*{{ $('Prepare Channel Lookup').item.json.user.name }}:* {{ $('Prepare Channel Lookup').item.json.messageText }}",
        "otherOptions": {}
