    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Check if this is WhatsApp inbound (has phoneNumber) or Slack inbound (has channelId but no phoneNumber)\nconst isFromWhatsApp = !!input.phoneNumber;\nconst isFromSlack = !!input.channelId && !input.phoneNumber;\n\nreturn [{\n  json: {\n    ...input,\n    direction: isFromWhatsApp ? 'whatsapp_to_slack' : 'slack_to_whatsapp',\n    isFromWhatsApp: isFromWhatsApp,\n    isFromSlack: isFromSlack\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        96
      ],
      "id": "3b0837aa-9179-4161-b423-ccdd8ad221ec",
