        848
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF-02: Detect Route\n// Determines which sub-workflow to call based on user status + message type\n// messageType from WF-01: 'text' or 'interactive'\n// rawMessage.interactive.type: 'button_reply' (button tap) or 'nfm_reply' (flow form)\n\nconst input = $input.first().json;\n\nconst userStatus = input.user?.status || null;\nconst messageType = input.messageType || 'text';\nconst interactiveType = input.rawMessage?.interactive?.type || null;\nconst pendingUser = input.pendingUser || null;\n\nlet route;\n\n// WhatsApp Flow form submission\nif (messageType === 'interactive' && interactiveType === 'nfm_reply') {\n  route = 'DETAILS_FORM';\n\n// Button tap (e.g. \"Payment Completed\")\n} else if (messageType === 'interactive' && interactiveType === 'button_reply') {\n  route = 'PAYMENT_CONFIRM';\n\n// No user record at all AND no pendingUser\n} else if (!userStatus && !pendingUser) {\n  route = 'NEW_USER';\n\n// pendingUser exists (received form, not yet submitted) — free text\n} else if (!userStatus && pendingUser) {\n  route = 'PRE_FORM_TEXT';\n\n// Text messages by status\n} else if (userStatus === 'payment_pending') {\n  route = 'PAYMENT_PENDING_TEXT';\n\n} else if (userStatus === 'payment_submitted') {\n  route = 'PAYMENT_SUBMITTED_TEXT';\n\n} else if (userStatus === 'consultation_active') {\n  route = 'RELAY';\n\n} else if (userStatus === 'consultation_closed') {\n  route = 'POST_CONSULT_TEXT';\n\n} else {\n  // blocked / opted_out / unknown — should not reach here (WF-01 filters these)\n  route = 'UNHANDLED';\n}\n\nreturn [{ json: { ...input, route } }];"
      },
