UBMITTED_TEXT';\n\n} else if (userStatus === 'consultation_active') {\n  route = 'RELAY';\n\n} else if (userStatus === 'consultation_closed') {\n  route = 'POST_CONSULT_TEXT';\n\n} else {\n  // blocked / opted_out / unknown — should not reach here (WF-01 filters these)\n  route = 'UNHANDLED';\n}\n\nreturn [{ json: { ...input, route } }];"},"id":"a2986c76-8972-4167-bfae-849f6ec6d186","name":"Detect Route","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1152,848]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.route }}","rightValue":"NEW_USER","operator":{"type":"string","operation":"equals"},"id":"r-001-new-user"}],"combinator":"and"},"renameOutput":true,"outputKey":"NEW_USER"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.route }}","rightValue":"PRE_FORM_TEXT","operator":{"type":"string","operation":"equals"},"id":"r-002-pre-form"}],"combinator":"and"},"renameOutput":true,"outputKey":"PRE_FORM_TEXT"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.route }}","rightValue":"DETAILS_FORM","operator":{"type":"string","operation":"equals"},"id":"r-003-details-form"}],"combinator":"and"},"renameOutput":true,"outputKey":"DETAILS_FORM"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.route }}","rightValue":"PAYMENT_CONFIRM","operator":{"type":"string","operation":"equals"},"id":"r-004-payment-confirm"}],"combinator":"and"},"renameOutput":true,"outputKey":"PAYMENT_CONFIRM"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.route }}","rightValue":"PAYMENT_PENDING_TEXT","operator":{"type